# ============================================================================
# EduOnline Platform - Variáveis de Ambiente (Template)
# ============================================================================

# SQL Server Configuration
SA_PASSWORD=<defina-uma-senha-forte>

# JWT Configuration
JWT_SECRET=<defina-um-segredo-jwt-forte>

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Logging Level
LOGLEVEL=Information

# API Base URLs (for local development)
AUTH_API_URL=http://localhost:5000
CONTEUDOS_API_URL=http://localhost:5001
ALUNOS_API_URL=http://localhost:5002
PAGAMENTOS_API_URL=http://localhost:5003
BFF_API_URL=http://localhost:5004

# Database Configuration
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=EduOnlineDB
DB_USER=sa

# Allowed Hosts
ASPNETCORE_ALLOWED_HOSTS=*

# Compose Project Name
COMPOSE_PROJECT_NAME=eduonline-dev
